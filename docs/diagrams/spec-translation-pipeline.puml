@startuml spec-translation-pipeline
title Translator — Translation Pipeline (target contract)

actor User
participant "Schema page\n(translate)" as UI
participant "translate_text\ncommand" as CMD
participant "TranslationService" as SVC
participant "Rules\n(helper)" as RULES
participant "trad engine\n(lazy singleton)" as ENG
queue "events" as EV

User -> UI : enter text, pick langs,\nCtrl+Enter
UI -> CMD : translate_text(text, source, target)
CMD -> CMD : request_id = counter++\n(AtomicUsize 0,1,2,…)
CMD --> UI : Ok(request_id) — immediate ack

CMD -> SVC : spawn translate_async(...)
activate SVC

SVC -> RULES : translate(text, src, tgt)
RULES -> RULES : text.trim().empty() ?
RULES --> EV : yes → error "Empty text provided"
RULES -> RULES : src == target ?
RULES --> SVC : passthrough (return input)\nBEFORE code validation
RULES -> RULES : catalog contains src ?\nelse "Unsupported source language: {code}"
RULES -> RULES : catalog contains tgt ?\nelse "Unsupported target language: {code}"
RULES -> ENG : ensure_initialized()\nsetup once behind RwLock
ENG --> RULES : ready (shared read guard)
RULES -> ENG : engine.translate(text, src, tgt)
alt engine error
  ENG --> RULES : "Translation failed: {e}"
else empty result
  ENG --> RULES : "" → error "Empty translation result"
else ok
  ENG --> RULES : translated string
end

RULES --> SVC : Result<String>

SVC -> SVC : wrap Response{translatedText,\nsourceLang, targetLang} + status/message
deactivate SVC

SVC -> EV : emit "translation-result"\npayload { requestId, text, sourceLang,\ntargetLang, response }
EV -> UI : correlate by requestId
UI -> UI : render result / toast\n(success | error, 3000 ms default)
opt successful translation
  UI -> SVC : save history entry\n{id,text,translatedText,sourceLang,\ntargetLang,timestamp}
end

note over UI,RULES
  Catalog (15): en es fr de it pt ru ja ko zh ar hi nl pl tr —
  names English…Turkish; get_supported_languages serves it
  without initializing the engine.
end note
@enduml
